[Unit]
Description=Portal service (wlRIX implementation)
PartOf=graphical-session.target
After=graphical-session.target
# This backend is a Wayland client: with no display to connect to it can only fail, and failing
# loudly at session start is worse than not being there. `wlrix-session` publishes
# WAYLAND_DISPLAY to the *user manager's* environment (see its src/systemd.rs) precisely so this
# condition can be met -- systemd checks it there, not against any session process.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.wlrix
ExecStart=@LIBEXECDIR@/xdg-desktop-portal-wlrix
Restart=on-failure
# Two seconds, not systemd's default 100ms. A restart worth making is one where the compositor
# is there to connect to, and the case that brings this unit down is precisely the one where it
# briefly is not: a session ending, or D-Bus activation arriving before the new compositor has
# opened its socket. At the default the five restarts systemd allows are spent inside a second,
# the start limit is hit, and the unit is then dead for the whole session that follows -- a
# desktop with no screen sharing and nothing on screen to say why. Spread over ten seconds the
# same five retries outlast the gap instead of racing it.
RestartSec=2s
